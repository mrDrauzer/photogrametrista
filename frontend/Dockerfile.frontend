# Build stage
FROM node:20-slim as build

WORKDIR /app

# Копируем только файлы зависимостей
COPY package.json package-lock.json* ./

# Установка зависимостей с кэшированием слоев Docker
# Если package.json не менялся, Docker пропустит этот шаг
RUN npm config set fetch-retry-maxtimeout 600000 && \
    npm config set fetch-retry-mintimeout 100000 && \
    npm install --no-audit --no-fund

# Копируем исходный код
COPY . .

# Сборка приложения
# Пропускаем тесты для ускорения, если нужно просто обновить
RUN npm run build

# Final stage
FROM nginx:alpine

# healthcheck в docker-compose использует `wget`, но в `nginx:alpine` его может не быть.
# Без этого контейнер помечается как unhealthy, хотя сайт работает.
RUN apk add --no-cache wget

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
